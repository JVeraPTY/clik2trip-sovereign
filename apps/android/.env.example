# How much test USD₮ one sandbox settlement transfers. A decimal amount sets the
# testnet nominal; `full` transfers the frozen booking total, as the Phase 4
# evidence run recorded. Defaults to 0.01 when unset. See docs/demo-catalog.md.
EXPO_PUBLIC_SANDBOX_TARIFF_USDT=0.01

# Never put secrets in EXPO_PUBLIC values. They are embedded in the APK.
