{
  "name": "cliktotrip-sovereign",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "evaluation:report": "node tools/build-performance-report.mjs",
    "evaluation:report:strict": "node tools/build-performance-report.mjs --strict",
    "evaluation:quality": "node tools/score-quality-evaluation.mjs",
    "evaluation:quality:strict": "node tools/score-quality-evaluation.mjs --strict",
    "android:start": "pnpm --filter @clik2trip/android start",
    "android:device": "pnpm --filter @clik2trip/android android",
    "android:prebuild": "pnpm --filter @clik2trip/android prebuild",
    "wdk:bundle": "pnpm --filter @clik2trip/android wdk:bundle"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
